          "schema:name": "R (Meta, X, TikTok) -v- OFCOM",
          "sota:sourceId": "src-judiciary-uk"
        },
        {
          "@type": "schema:CreativeWork",
          "schema:url": "https://www.thelawyer.com/defeat-for-big-tech-in-first-court-challenge-against-online-safety-act-powers/",
          "schema:name": "Defeat for Big Tech in first court challenge against Online Safety Act powers",
          "sota:sourceId": "src-the-lawyer"
        }
      ],
      "schema:about": [
