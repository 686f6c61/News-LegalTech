        {
          "@type": "schema:CreativeWork",
          "schema:url": "https://www.lawyerpress.com/2026/10/27/la-aepd-advierte-de-los-riesgos-de-los-agentes-de-ia-y-recomienda-no-permitirles-actuar-sin-autorizacion/",
          "schema:name": "La AEPD advierte de los riesgos de los agentes de IA y recomienda no permitirles actuar sin autorización",
