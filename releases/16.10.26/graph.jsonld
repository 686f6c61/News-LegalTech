        }
      ]
    },
    {
      "@id": "https://github.com/686f6c61/News-LegalTech/events/evt-2026-10-16-cocounsel-legal-multinational-profile",
      "@type": "schema:Article",
      "schema:identifier": "evt-2026-10-16-cocounsel-legal-multinational-profile",
      "schema:headline": "Thomson Reuters lanza el Multinational Profile de CoCounsel Legal: research transfronterizo de más de 100 países en un flujo",
      "schema:datePublished": "2026-10-14",
      "schema:inLanguage": "es",
      "schema:abstract": "Thomson Reuters anunció el 14 de octubre de 2026 la nueva generación de CoCounsel Legal a escala global y, con ella, el Multinational Profile: contenido jurídico de más de 100 países y territorios dentro de un único flujo de CoCounsel Legal. Según la nota de prensa, permite investigar requisitos legales y de compliance en varios países, comparar diferencias clave, identificar cuestiones que pueden requerir asesoramiento local y trazar cada hallazgo hasta su fuente, sin cambiar de herramienta. La nueva generación está disponible ya en el Reino Unido, con disponibilidad general prevista antes de que acabe octubre en países como Australia, Brasil, Canadá, Singapur y Emiratos; el Multinational Profile llegará a clientes de EE. UU., Europa, Reino Unido, Canadá y Australia a lo largo de octubre.",
      "schema:articleBody": "Thomson Reuters anunció el 14 de octubre de 2026 la nueva generación de CoCounsel Legal a escala global y, con ella, el Multinational Profile: contenido jurídico de más de 100 países y territorios dentro de un único flujo de CoCounsel Legal. Según la nota de prensa, permite investigar requisitos legales y de compliance en varios países, comparar diferencias clave, identificar cuestiones que pueden requerir asesoramiento local y trazar cada hallazgo hasta su fuente, sin cambiar de herramienta. La nueva generación está disponible ya en el Reino Unido, con disponibilidad general prevista antes de que acabe octubre en países como Australia, Brasil, Canadá, Singapur y Emiratos; el Multinational Profile llegará a clientes de EE. UU., Europa, Reino Unido, Canadá y Australia a lo largo de octubre.\n\nPara un in-house con operaciones en varias jurisdicciones o un despacho que coordina corresponsales, el atractivo es una primera pasada comparada antes de pedir opinión local, con la fuente a la vista. La pregunta clave es la profundidad real por país: no es lo mismo Westlaw y Practical Law en EE. UU. o Reino Unido que la cobertura en mercados donde Thomson Reuters no tiene contenido editorial propio. Llega la misma semana en que Thomson Reuters queda fuera de Copilot for Legal salvo por HighQ. Matiz: es un comunicado del proveedor; no detalla qué fuentes cubre cada país ni la cobertura para España.",
      "sota:type": "product",
      "sota:sotaScore": 7.5,
      "sota:aiLegaltech": true,
      "sota:whySota": "Research comparado de más de 100 jurisdicciones dentro de una plataforma agéntica incumbente.",
      "sota:whyNow": "Nota de prensa del 14 oct 2026; despliegue durante octubre. NEW frente a TR×OpenAI (descartado 10-15).",
      "sota:geo": [
        "Global",
        "GB",
        "US"
      ],
      "sota:topics": [
        "research",
        "transfronterizo",
        "compliance",
        "cocounsel"
      ],
      "sota:summaryP1": "Thomson Reuters anunció el 14 de octubre de 2026 la nueva generación de CoCounsel Legal a escala global y, con ella, el Multinational Profile: contenido jurídico de más de 100 países y territorios dentro de un único flujo de CoCounsel Legal. Según la nota de prensa, permite investigar requisitos legales y de compliance en varios países, comparar diferencias clave, identificar cuestiones que pueden requerir asesoramiento local y trazar cada hallazgo hasta su fuente, sin cambiar de herramienta. La nueva generación está disponible ya en el Reino Unido, con disponibilidad general prevista antes de que acabe octubre en países como Australia, Brasil, Canadá, Singapur y Emiratos; el Multinational Profile llegará a clientes de EE. UU., Europa, Reino Unido, Canadá y Australia a lo largo de octubre.",
      "sota:summaryP2": "Para un in-house con operaciones en varias jurisdicciones o un despacho que coordina corresponsales, el atractivo es una primera pasada comparada antes de pedir opinión local, con la fuente a la vista. La pregunta clave es la profundidad real por país: no es lo mismo Westlaw y Practical Law en EE. UU. o Reino Unido que la cobertura en mercados donde Thomson Reuters no tiene contenido editorial propio. Llega la misma semana en que Thomson Reuters queda fuera de Copilot for Legal salvo por HighQ. Matiz: es un comunicado del proveedor; no detalla qué fuentes cubre cada país ni la cobertura para España.",
      "schema:citation": [
