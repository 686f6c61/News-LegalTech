          "schema:name": "Candle AI Joins the iManage Technology Partner Program to Connect Legal Email Workflows with Trusted Knowledge",
          "sota:sourceId": "src-lawnext"
        }
      ],
      "schema:about": [
        {
          "@id": "https://github.com/686f6c61/News-LegalTech/entities/ent-candle-ai"
