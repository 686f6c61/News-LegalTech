          "schema:url": "https://www.legalfutures.co.uk/latest-news/sra-moves-to-take-unlimited-fining-power-for-economic-crime",
          "schema:name": "SRA moves to take unlimited fining power for economic crime",
          "sota:sourceId": "src-legal-futures"
        }
      ],
      "schema:about": [
