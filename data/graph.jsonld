          "schema:url": "https://www.law.com/legaltechnews/2026/10/02/legaltech-rundown-harvey-partners-with-japanese-legal-data-company-ivo-unveils-open-source-model-and-more-/",
          "schema:name": "Legaltech Rundown: Harvey Partners With Japanese Legal Data Company, Ivo Unveils Open-Source Model, and More",
          "sota:sourceId": "src-legaltech-news-law-com-alm"
        }
      ],
      "schema:about": [
