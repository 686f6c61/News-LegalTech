          "schema:name": "ArentFox Schiff Launches FoxAI Tech Tools for Industry-Focused Approach",
          "sota:sourceId": "src-legaltech-news-law-com-alm"
        }
      ],
      "schema:about": [
        {
          "@id": "https://github.com/686f6c61/News-LegalTech/entities/ent-arentfox-schiff"
